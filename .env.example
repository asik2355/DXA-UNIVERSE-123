# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: The token for your Telegram bot from @BotFather.
TELEGRAM_BOT_TOKEN="8679304107:AAEZa23KwTeaVxuIbClwe_LYJ-315gne-4U"

# TELEGRAM_API_ID: Get this from https://my.telegram.org
TELEGRAM_API_ID="35959554"

# TELEGRAM_API_HASH: Get this from https://my.telegram.org
TELEGRAM_API_HASH="f2704f1b44114f13d5637ed1730ec326"

# TELEGRAM_SESSION_FILE: Path to save the session string for persistence
TELEGRAM_SESSION_FILE="session.txt"

# TELEGRAM_SOURCE_GROUP_ID: The ID of the group to forward FROM.
TELEGRAM_SOURCE_GROUP_ID="-1003787486402"

# TELEGRAM_TARGET_GROUP_ID: The ID of the group where messages should be forwarded TO.
TELEGRAM_TARGET_GROUP_ID="-1003949536377"

# TELEGRAM_TARGET_TOPIC_ID: The ID of the topic/thread within the target group.
TELEGRAM_TARGET_TOPIC_ID="844"
